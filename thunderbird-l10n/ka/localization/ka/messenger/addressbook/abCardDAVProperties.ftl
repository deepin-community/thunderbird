carddav-url-label =
    .value = CardDAV ბმული:
    .accesskey = V
carddav-refreshinterval-label =
    .label = დასინქრონება:
    .accesskey = ქ
carddav-refreshinterval-minutes-value =
    .label =
        { $minutes ->
            [one] ყოველ წუთში
           *[other] ყოველ { $minutes } წუთში
        }
carddav-refreshinterval-hours-value =
    .label =
        { $hours ->
            [one] ყოველ საათში
           *[other] ყოველ { $hours } საათში
        }
carddav-readonly-label =
    .label = მხოლოდ წასაკითხი
    .accesskey = ხ
