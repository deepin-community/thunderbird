commands-key =
    Komutlar: { $command }.
    Daha fazla bilgi için /help &lt;komutunu&gt; yazın.
no-command = '{ $command }' komutu yok.
no-help-key = '{ $command }' komutu için yardım iletisi yok. Üzgünüm!
say-help-string = say &lt;ileti&gt;: Komutları işlemeden bir ileti gönderir.
raw-help-string = raw &lt;ileti&gt;: HTML etiketlerinden temizlemeden olduğu gibi bir ileti gönderir.
help-help-string = help &lt;name&gt;: &lt;name&gt; komutu için yardım iletisi göster veya parametre olmadan kullanılabilecek olası komutları listele.
status-command = { $command } &lt;durum iletisi&gt;: İsteğe bağlı durum iletisiyle birlikte durumu "{ $status }" olarak ayarlar.
back-key-key = uygun
away-key-key = uzakta
busy-key-key = uygun değil
dnd-key-key = uygun değil
offline-key-key = çevrimdışı
