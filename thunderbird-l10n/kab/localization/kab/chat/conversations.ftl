topic-not-set = Ulac asentel n udiwenni di { $conversationName }.
topic-changed = { $user } isnifel asentel n udiwenni s: { $topic }.
topic-cleared = { $user } isfeḍ asentel n udiwenni.
nick-set-key = { $oldNick } yettwassen tura s { $newNick }.
nick-set-you = Tettwassen tura s { $newNick }.
