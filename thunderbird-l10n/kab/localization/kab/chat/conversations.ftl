target-changed = Adiwenni ad yeddu d { $targetName }, s useqdec n { $targetProtocol }.
status-changed = { $displayName } yuɣal tura { $statusType }.
status-changed-with-status-text = { $displayName } yuɣal tura { $statusType }:{ $statusText }.
status-changed-from-unknown = { $displayName } d-{ $statusType }.
status-changed-from-unknown-with-status-text = { $displayName } d-{ $statusType }: { $statusText }.
status-known = Amiḍan-ik iţwaqqen tikelt nniḍen ({ $displayName } d-{ $statusType }).
status-known-with-status-text = Amiḍan-ik iţwaqqen tikelt nniḍen ({ $displayName } d-{ $statusType }: { $statusText }).
status-unknown = Amiḍan ik inser si tuqqna (addan n { $displayName } ur izgi ara yettwassen).
account-disconnected = Amiḍan-inek iffeɣ si tuqqna.
account-reconnected = Amiḍan-inek yeqqen tickelt nniḍen.
auto-reply = Tiririt tawurmant - { $message }
