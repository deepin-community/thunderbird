commands-key =
    Órdenes: { $command }.
    Usa /help &lt;orde&gt; pa más información.
no-command = Nun esiste la orde '{ $command }'.
no-help-key = Nun hai mensaxe d'ayuda pa la orde '{ $command }', ¡sentímoslo!
say-help-string = say &lt;mensaxe&gt;: unvia un mensaxe ensin procesar denguna orde.
raw-help-string = raw &lt;mensaxe&gt;: unvia un mensaxe ensin escapar les entidaes HTML.
help-help-string = help &lt;nome&gt;: amuesa'l mensaxe d'ayuda pa la orde &lt;nome&gt;, o la llista de posibles órdenes si s'usa ensin parámetru.
status-command = { $command } &lt;mensaxe d'estáu&gt;: afita l'estáu en { $status } con un mensaxe d'estáu opcional.
