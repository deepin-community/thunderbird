carddav-url-label =
    .value = CardDAV-URL:
    .accesskey = V
carddav-refreshinterval-label =
    .label = Synchroniseren:
    .accesskey = S
carddav-refreshinterval-minutes-value =
    .label =
        { $minutes ->
            [one] elke minuut
           *[other] elke { $minutes } minuten
        }
carddav-refreshinterval-hours-value =
    .label =
        { $hours ->
            [one] elk uur
           *[other] elke { $hours } uur
        }
carddav-readonly-label =
    .label = Alleen-lezen
    .accesskey = A
