commands-key =
    Käsud: { $command }.
    Lisateabe saamiseks kasuta "/help &lt;käsk&gt;".
no-command = Käsku '{ $command }' ei ole.
no-help-key = Käsul '{ $command }' puudub abiteave, palume vabandust!
say-help-string = say &lt;sõnum&gt;: sõnum saadetakse käske töötlemata.
raw-help-string = raw &lt;sõnum&gt;: sõnum saadetakse HTML märgiseid varjestamata.
help-help-string = help &lt;käsk&gt;: näitab käsu &lt;käsk&gt; abiteavet või reastab saadaolevad käsud, kui kasutatakse ilma parameetrita.
status-command = { $command } &lt;olekuteade&gt;: seab olekusse { $status }, valikulise olekuteatega.
back-key-key = saadaval
away-key-key = eemal
busy-key-key = hõivatud
dnd-key-key = mittesaadaval
offline-key-key = ühendamata
