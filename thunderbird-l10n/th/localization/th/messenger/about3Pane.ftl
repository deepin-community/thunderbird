               *[other] ไม่ได้อ่าน <span>1</span> จาก <span>{ $total }</span> ข้อความ
            }
       *[other]
            { $total ->
                [one] ไม่ได้อ่าน <span>{ $unread }</span> จาก <span>1</span> ข้อความ
               *[other] ไม่ได้อ่าน <span>{ $unread }</span> จาก <span>{ $total }</span> ข้อความ
            }
    }
