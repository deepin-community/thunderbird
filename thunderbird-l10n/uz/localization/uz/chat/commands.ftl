commands-key =
    Buyruqlar: { $command }.
    Ko‘proq ma’lumot olish uchun /help &lt;buyruq&gt; buyrug‘idan foydalaning.
no-command = '{ $command }' buyrug‘i yo‘q.
no-help-key = '{ $command }' buyrug‘i uchun yordam xabari yo‘q, kechirasiz!
