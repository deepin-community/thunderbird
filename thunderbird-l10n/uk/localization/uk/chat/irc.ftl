message-ping =
    { $delay ->
        [one] Час відповіді від { $source } – { $delay } мілісекунда.
        [few] Час відповіді від { $source } – { $delay } мілісекунди.
       *[many] Час відповіді від { $source } – { $delay } мілісекунд.
    }
