    { $delay ->
        [one] Respontet en deus { $source } d'ar ping e { $delay } vilieilenn.
        [two] Respontet en deus { $source } d'ar ping e { $delay } vilieilenn.
        [few] Respontet en deus { $source } d'ar ping e { $delay } milieilenn.
