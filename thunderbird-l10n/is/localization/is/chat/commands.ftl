commands-key =
    Skipanir: { $command }.
    Notaðu /help &lt;skipun&gt; fyrir meiri upplýsingar.
no-command = Engin '{ $command }' skipun.
no-help-key = Engin hjálparskilaboð eru fyrir '{ $command }' skipunina, því miður!
say-help-string = say &lt;message&gt;: senda skilaboð án þess að vinna úr skipun.
raw-help-string = raw &lt;message&gt;: senda skilaboð án þess umbreyta HTML einindum.
help-help-string = help &lt;name&gt;: sýna hjálparskilaboð fyrir &lt;name&gt; skipun, eða birta lista af mögulegum skipunum ef ekkert viðfang er með.
status-command = { $command } &lt;status skilaboð&gt;: setur stöðu á { $status } með valkvæmum skilaboðum.
back-key-key = tiltæk/ur
away-key-key = fjarverandi
busy-key-key = upptekin/n
dnd-key-key = upptekin/n
offline-key-key = aftengd/ur
