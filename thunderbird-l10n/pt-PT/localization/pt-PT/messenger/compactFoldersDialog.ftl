compact-folders-dialog-title = Compactar pastas
compact-dialog =
    .buttonlabelaccept = Compactar agora
    .buttonaccesskeyaccept = C
    .buttonlabelcancel = Lembrar depois
    .buttonaccesskeycancel = L
    .buttonlabelextra1 = Aprender mais…
    .buttonaccesskeyextra1 = A
compact-dialog-message = O { -brand-short-name } precisa de fazer uma manutenção regular aos ficheiros para melhorar o desempenho das suas pastas. Isto irá recuperar { $data } de espaço em disco sem alterar as suas mensagens. Para permitir que o { -brand-short-name } faça isto automaticamente no futuro sem perguntar, marque a caixa abaixo antes de escolher ‘{ compact-dialog.buttonlabelaccept }’.
compact-dialog-never-ask-checkbox =
    .label = Compactar pastas automaticamente no futuro
    .accesskey = C
